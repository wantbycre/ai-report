## 4. Query 훅

```ts
// useGoldChart.ts — 운영 프로젝트 React Query 규칙 따름
export const goldChartQueryKey = (range: ChartRange) => ['goldChart', { range }] as const;

export function useGoldChart(range: ChartRange) {
  return useQuery({
    queryKey: goldChartQueryKey(range),
    queryFn: async () => {
      const res = await getGoldChart(range);
      return toLightChartData(res.data.data); // 운영 ApiResponse 래핑에 맞게 select 조정
    },
    staleTime: 30_000,
  });
}
```

`LightChartPanel` 변경:

```ts
// Before
const { bars, periodStats, ticker } = getLightChartMock(key);

// After — props 또는 훅
const { data, isLoading, isError } = useGoldChart(range);
// applyRangeData 호출 시 data.bars, data.periodStats, data.ticker, data.avgBuyPrice 사용
```

